# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app
/ProjectSettings/BurstAotSettings_*.json

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Aa]ndroid/
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Aa]ndroid.meta
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Ii][Oo][Ss]/
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Ii][Oo][Ss].meta
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Oo][Ss][Xx]/
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Oo][Ss][Xx].meta
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Ww]eb[Gg][Ll]/
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Ww]eb[Gg][Ll].meta
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Ss]tandalone[Oo][Ss][Xx]/
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Ss]tandalone[Oo][Ss][Xx].meta
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Ss]tandalone[Ww]indows/
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Ss]tandalone[Ww]indows.meta
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Ss]tandalone[Ww]indows64/
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Ss]tandalone[Ww]indows64.meta
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Ss]tandalone[Ll]inux64/
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Ss]tandalone[Ll]inux64.meta
/[Ss]erver[Dd]ata/

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

/Assets/StreamingAssets/build_info
Assets/StreamingAssets/build_info

Assets/StreamingAssets/
.idea/.idea.DS/.idea/copilot.data.migration.ask.xml
.idea/.idea.DS/.idea/copilot.data.migration.ask2agent.xml
.aider*
.venv*
.env
node_modules*
Assets/Test/
Assets/Test.meta
Assets/Tests*
# Keep P2 foundation regression tests and their Unity metadata.
!/Assets/Tests/
!/Assets/Tests/**
!/Assets/Tests.meta
*.slnx

# Local logs and crash dumps
/Editor *.log
/mono_crash*.json
/response.txt
/__pycache__/
*.pyc
.DS_Store
/Error.md
/package.json
/package-lock.json

# Local dungeon Seed Scan reports
/Assets/1_InternalTools/DungeonGeneration/Reports/*.json
/Assets/1_InternalTools/DungeonGeneration/Reports/*.json.meta

# Local NuGet package leftovers
/Packages/MessagePack.2.6.100-alpha/
/Packages/MessagePack.Annotations.2.6.100-alpha/
/Packages/Microsoft.Bcl.AsyncInterfaces.6.0.0/
/Packages/Microsoft.NET.StringTools.17.4.0/
/Packages/System.Collections.Immutable.7.0.0/

# Nested Unity project and local inference artifacts
/MN/Library/
/MN/Temp/
/MN/Obj/
/MN/Logs/
/MN/UserSettings/
/MN/.vs/
/MN/.idea/
/.local/
/Builds/
/TestResults/
